    "vite": "^6.4.1"
  },
  "type": "module",
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "@threlte/core": "^8.3.1",
    "@threlte/extras": "^9.7.1",
    "@types/three": "^0.182.0",
    "flowbite": "^4.0.1",
    "flowbite-svelte": "^1.30.1",
    "flowbite-svelte-icons": "^3.0.1",
